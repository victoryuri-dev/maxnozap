---
export interface Props {
  title?: string;
}

const { title = 'Quiz — Max Orça' } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link
      href="https://fonts.googleapis.com/css2?family=Boldonse&family=Epilogue:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <slot />
  </body>
</html>

<style is:global>
  @keyframes hero-surgir {
    0% {
      transform: translateY(60%) translateX(-50%);
    }
    100% {
      transform: translateY(0) translateX(-50%);
    }
  }

  @keyframes surgir {
    0% {
      transform: translateY(100%);
    }
    100% {
      transform: translateY(0);
    }
  }

  @keyframes surgir {
    0% {
      transform: translateY(200%);
    }
    100% {
      transform: translateY(0);
    }
  }

  @keyframes float{
	0%,100%{
		transform:translatey(0) translateX(2) rotate(0deg)
	}
	50%{
		transform:translatey(3px) translateX(-2px) rotate(2deg)
	}
}
.efeito-flutuante-infinito {
     animation: float 6s ease-in-out infinite;
}

  :root {
    --azul: #0e33eb;
    --azul-esc: #081b80;
    --verde: #c6ff3d;
    --gelo: #f4f4f4;
    --preto: #181F36;
    --cinza: #8a8fa3;
    --vermelho: #ff3b30;
    --display: 'Epilogue', sans-serif;
    --display-hero: 'Boldonse', sans-serif;
    --corpo: 'Epilogue', sans-serif;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html,
  body {
    height: 100%;
  }

  body {
    font-family: var(--corpo);
    background: var(--gelo);
  }

  /* .phone = casca de fundo, ocupa a viewport inteira; o conteúdo (texto,
   formulário, botões) fica sempre restrito ao tamanho de celular via .content-col */
  .phone {
    width: 100%;
    height: 100vh;
    height: 100dvh;
    background: var(--gelo);
    position: relative;
    display: flex;
    flex-direction: column;
  }

  .content-col {
    max-width: 420px;
    margin: 0 auto;
    padding: 28px 24px 32px;
    position: relative;
  }

  /* progresso */
  .progress {
    max-width: 420px;
    width: 100%;
    margin: 0 auto;
    height: 6px;
    background: #dde1f0;
    flex: none;
  }

  .progress .bar {
    height: 100%;
    background: var(--azul);
    width: 0%;
    transition: width 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
    border-radius: 0 4px 4px 0;
  }

  .screen-stack {
    position: relative;
    flex: 1;
    overflow: hidden;
  }

  .screen {
    position: absolute;
    inset: 0;
    overflow-y: auto;
    overflow-x: hidden;
    padding: 0;
    display: none;
  }

  .screen.active {
    display: block;
  }

  /* telas com transição própria via JS (push/stagger) não levam o fade — só quem
   pede .fade-screen (hoje, só a solução) usa a animação padrão */
  .screen.fade-screen {
    animation: fade 0.45s ease;
  }

  @keyframes fade {
    from {
      opacity: 0;
      transform: translateY(14px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  /* loading e diagnóstico continuam no azul da tela 0, sem cortar pro fundo claro */
  .screen.bg-azul {
    background: var(--azul);
  }

  /* tela de transição: só um texto centralizado, tocável em qualquer ponto pra avançar */
  .screen.transition-screen.active {
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* cobre a tela inteira: tocar em qualquer ponto (inclusive sobre o texto) avança —
   funciona porque é transparente e fica por cima só pra efeito de clique, nunca visual.
   z-index maior que o da .s0-sheet (3), senão a folha branca fica na frente e engole o toque */
  .screen-tap {
    position: absolute;
    inset: 0;
    z-index: 4;
    background: none;
    border: none;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }

  .transition-text {
    font-family: var(--display);
    font-weight: 800;
    font-size: 22px;
    line-height: 1.35;
    letter-spacing: -0.3px;
    color: var(--preto);
    text-align: center;
    margin: 0 0 14px;
  }

  .transition-screen .micro {
    margin-top: 0;
  }

  .brand {
    font-family: var(--display);
    font-weight: 800;
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--azul);
    margin-bottom: 18px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .brand .brand-logo {
    height: 24px;
    width: auto;
    display: block;
  }

  .step-tag {
    font-family: var(--display);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--cinza);
    margin-bottom: 14px;
  }

  h2 {
    font-family: var(--display);
    font-size: 24px;
    font-weight: 800;
    letter-spacing: -0.6px;
    line-height: 1.2;
    margin-bottom: 24px;
    color: var(--preto);
  }

  .sub {
    font-size: 17.5px;
    color: #55555f;
    line-height: 1.55;
    margin-bottom: 18px;
  }

  .sub .hl {
    color: var(--azul);
    font-weight: 700;
  }

  /* telas com hero azul full-bleed + folha branca sobrepondo por cima — tela 0 e a
   abertura da solução são as duas telas com esse tratamento hoje */
  .screen.hero-screen {
    padding: 0;
    overflow: hidden;
  }

  /* hero das telas .hero-screen */
  .hero-wrap {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: var(--azul);
    z-index: 1;
  }

  .hero-swoosh {
    position: absolute;
    width: 420vw;
    max-width: none;
    left: 46%;
    top: 30%;
    transform: translate(-50%, -50%) rotate(4deg);
    z-index: 1;
    filter: brightness(0.9);
  }

  .hero-img {
    position: absolute;
    left: 50%;
    top: 10px;
    width: 95%;
    min-width: 325px;
    transform: translateX(-50%);
    z-index: 2;
    animation: hero-surgir 0.8s cubic-bezier(0.68, -0.4, 0.32, 1.2);
  }

  .s0-sheet {
    position: absolute;
    margin: auto;
    width: 100%;
    left: 0;
    right: 0;
    min-height: fit-content;
    height: 55%;
    width: 100%;
    bottom: 0;
    padding: 30px 0px 0;
    z-index: 3;
    background: var(--gelo);
    border-radius: 30px 30px 0 0;
    overflow-y: auto;
    animation: 0.6s ease-in-out surgir;
    overflow-y: hidden;
  }

  .s0-sheet .content-col {
    animation: 0.8s ease-in-out surgir;
  }

  .s0-sheet .content-col h2 {
    animation: 0.9s ease-in-out surgir;
  }
  .s0-sheet .content-col p:nth-of-type(1) {
    animation: 1s ease-in-out surgir;
  }
  .s0-sheet .content-col p:nth-of-type(2) {
    animation: 1.3s ease-in-out surgir;
  }
  .s0-sheet .content-col p:nth-of-type(3) {
    animation: 1.4s ease-in-out surgir;
  }
  .s0-sheet .content-col .btn {
    animation: 1.5s ease-in-out surgir;
  }

  @media screen and (min-width: 420px) {
    .s0-sheet {
      width: fit-content;
      padding: 30px 30px 0;
    }

    .hero-img {
      max-width: 420px;
    }

    .hero-swoosh {
      width: 150vw;
    }
  }

  .s0-sheet .content-col {
    padding: 34px 26px 30px;
  }

  h2.hero-title {
    font-family: var(--display-hero);
    font-weight: 400;
    font-size: 30px;
    line-height: 1.35;
    letter-spacing: 0;
    margin: 0 0 30px;
    text-transform: uppercase;
  }

  /* botões estilo "shadow box": container (.opt/.btn) só ancora a sombra;
   quem tem o fundo/borda e se desloca no hover é o .face interno —
   assim a sombra (z-index:-1) fica isolada no seu próprio contexto de
   empilhamento e nunca pinta por cima do .face. */
  .opt,
  .btn {
    position: relative;
    z-index: 0;
    display: block;
    width: 100%;
    cursor: pointer;
    background: none;
    border: none;
    padding: 0;
    font: inherit;
    color: inherit;
    -webkit-tap-highlight-color: transparent;
  }

  .opt::after,
  .btn::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--preto);
    transform: translate(-6px, 6px);
    transition: background-color 0.15s ease;
  }

  .opt::after {
    border-radius: 999px;
  }

  .btn::after {
    border-radius: 50px;
  }

  .opt:hover::after,
  .btn:hover::after {
    background: var(--azul-esc);
  }

  .face {
    display: block;
    transform: translate(0, 0);
    transition:
      transform 0.15s ease-out,
      background-color 0.15s ease,
      border-color 0.15s ease,
      color 0.15s ease;
  }

  .opt:hover .face,
  .btn:hover .face {
    transform: translate(4px, -4px);
  }

  /* opções sem checkbox */
  .opt {
    margin-bottom: 16px;
  }

  .opt .face {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    text-align: left;
    background: #fff;
    border: 3px solid var(--preto);
    border-radius: 999px;
    padding: 17px 20px;
    font-family: var(--display);
    font-weight: 600;
    font-size: 14.5px;
    color: var(--preto);
  }

  .opt:hover .face {
    border-color: var(--azul);
  }

  .opt.picked .face {
    background: var(--azul);
    border-color: var(--azul);
    color: #fff;
  }

  .opt .em {
    font-size: 19px;
  }

  .btn {
    margin-top: 40px;
  }

  .btn .face {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    width: 100%;
    background: var(--azul);
    color: #fff;
    border: 3px solid var(--preto);
    border-radius: 50px;
    padding: 18px;
    font-family: var(--display);
    font-weight: 700;
    font-size: 17px;
    letter-spacing: 0.3px;
    text-align: center;
    text-decoration: none;
  }

  /* chama atenção pro CTA principal: 2 pulinhos, pausa, 2 pulinhos de novo —
   só o .face pula (a sombra do ::after fica parada), então o botão "descola"
   da sombra a cada salto, igual ao efeito de hover só que automático */
  @keyframes bounce-face {
    0%,
    14.3%,
    100% {
      transform: translate(0, 0);
    }
    3.6% {
      transform: translate(0, -14px);
    }
    7.1% {
      transform: translate(0, 0);
    }
    10.7% {
      transform: translate(0, -9px);
    }
  }

  .btn-bounce .face {
    animation: bounce-face 5.83s ease-in-out 1.75s infinite;
  }

  .btn-bounce:hover .face {
    animation-play-state: paused;
  }

  .micro {
    text-align: center;
    font-size: 12px;
    color: var(--cinza);
    margin-top: 16px;
  }

  .phone-footer {
    flex: none;
    text-align: center;
    font-size: 11px;
    color: #c3c6d4;
    padding: 8px 0 14px;
    font-family: var(--display);
    font-weight: 600;
    letter-spacing: 0.3px;
  }

  .phone.no-footer .phone-footer {
    display: none;
  }

  input.field {
    width: 100%;
    background: #fff;
    border: 2px solid #e6e6ec;
    border-radius: 14px;
    padding: 16px;
    font-family: var(--corpo);
    font-weight: 600;
    font-size: 16px;
    margin-bottom: 16px;
    color: var(--preto);
    outline: none;
  }

  input.field:focus {
    border-color: var(--azul);
  }

  .err {
    color: #d33;
    font-size: 13px;
    font-weight: 600;
    margin: -4px 0 10px;
    display: none;
  }

  /* loading */
  .loading-content {
    min-height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .loader-wrap {
    text-align: center;
  }

  .spinner {
    width: 56px;
    height: 56px;
    border: 5px solid rgba(255, 255, 255, 0.3);
    border-top-color: #fff;
    border-radius: 50%;
    margin: 0 auto 26px;
    animation: spin 1s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .load-txt {
    font-family: var(--display);
    font-weight: 700;
    font-size: 17px;
    color: #fff;
  }

  /* diagnóstico — o prejuízo é o herói da tela (grande, sozinho), o resto é
   só 3 fatos rápidos de escanear, não parágrafo pra ler */
  .diag-hero {
    text-align: center;
    padding: 6px 4px 30px;
  }

  .diag-hero-eyebrow {
    font-family: var(--display);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.75);
    margin-bottom: 12px;
  }

  .diag-hero-lead {
    font-size: 16px;
    color: #fff;
    margin-bottom: 6px;
  }

  .diag-hero-lead strong {
    font-weight: 800;
  }

  .diag-hero-value {
    font-family: var(--display);
    font-weight: 900;
    font-size: 32px;
    line-height: 1.15;
    letter-spacing: -0.3px;
    text-transform: uppercase;
    color: #fff;
  }

  .diag-row {
    display: flex;
    align-items: center;
    gap: 14px;
    background: #fff;
    border-radius: 16px;
    padding: 16px 18px;
    margin-bottom: 14px;
  }

  .diag-row-icon {
    flex: none;
    font-size: 26px;
    line-height: 1;
  }

  .diag-row-title {
    font-family: var(--display);
    font-weight: 800;
    font-size: 16px;
    color: var(--preto);
    margin-bottom: 2px;
  }

  .diag-row-sub {
    font-size: 13px;
    color: #6b6f7d;
    line-height: 1.4;
  }

  .diag-veredito {
    font-size: 15px;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.9);
    text-align: center;
    margin: 18px 0 26px;
  }

  .diag-veredito strong {
    color: #fff;
  }

  .diag-cta-lead {
    font-family: var(--display);
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.3px;
    line-height: 1.3;
    color: #fff;
    text-align: center;
    margin-bottom: 20px;
  }

  .diag-cta-lead .hl-lime {
    color: var(--verde);
  }

  /* variante lima do .btn — usada no CTA do diagnóstico */
  .btn.btn-lime .face {
    background: var(--verde);
    color: var(--preto);
  }

  /* mesma lógica da .s0-sheet: cada bloco tem uma duração diferente da animação
   "surgir" — como todos começam juntos, quem tem duração maior ainda está subindo
   quando quem tem duração menor já parou, e isso cria a cascata */
  .diag-content .diag-hero {
    animation: 0.9s ease-in-out surgir;
  }
  .diag-content .diag-row:nth-of-type(2) {
    animation: 1s ease-in-out surgir;
  }
  .diag-content .diag-row:nth-of-type(3) {
    animation: 1.15s ease-in-out surgir;
  }
  .diag-content .diag-row:nth-of-type(4) {
    animation: 1.3s ease-in-out surgir;
  }
  .diag-content .diag-veredito {
    animation: 1.45s ease-in-out surgir;
  }
  .diag-content .diag-cta-lead {
    animation: 1.6s ease-in-out surgir;
  }
  .diag-content .btn {
    animation: 1.75s ease-in-out surgir;
  }

  /* solução — CTA final: manda pro WhatsApp. tela escura, contraste com o resto do quiz */
  .screen.bg-preto {
    background: var(--preto);
  }

  .screen.bg-preto h2 {
    color: #fff;
  }

  .audio-head {
    position: relative;
    margin-bottom: 26px;
  }

  .audio-head h2 {
    margin-bottom: 0;
    padding-right: 100px;
  }

  .whats-sticker {
    position: absolute;
    top: 52px;
    right: -14px;
    width: 224px;
    height: auto;
  }

  .audio-note {
    font-family: var(--display);
    font-weight: 800;
    font-size: 19px;
    color: #fff;
    line-height: 1.4;
  }

  .audio-note:first-of-type {
    margin-top: 130px;
  }

  .hl-muted {
    color: var(--cinza);
  }

  .audio-cta {
    position: relative;
    display: block;
    width: 100%;
    background: var(--azul);
    color: #fff;
    text-align: center;
    font-family: var(--display);
    font-weight: 800;
    font-size: 16px;
    letter-spacing: 0.2px;
    padding: 18px;
    border-radius: 14px;
    text-decoration: none;
    margin: 30px 0 22px;
  }

  .audio-cta::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -9px;
    transform: translateX(-50%);
    width: 0;
    height: 0;
    border-left: 9px solid transparent;
    border-right: 9px solid transparent;
    border-top: 9px solid var(--azul);
  }

  .gift-img {
    display: block;
    position: absolute;
    width: 65vh;
    width: 46rem;
    top: 400px;
    left: -282px;
  }

  /* ferramenta de dev — só existe em `astro dev`, nunca no build publicado */
  .dev-nav {
    position: fixed;
    right: 14px;
    bottom: 14px;
    z-index: 999;
    display: flex;
    align-items: center;
    gap: 6px;
    background: rgba(13, 13, 13, 0.88);
    border-radius: 999px;
    padding: 6px 8px;
    box-shadow: 0 6px 18px rgba(0, 0, 0, 0.28);
  }

  .dev-nav-btn {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    border: none;
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    font-size: 15px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    -webkit-tap-highlight-color: transparent;
  }

  .dev-nav-btn:hover {
    background: rgba(255, 255, 255, 0.28);
  }

  .dev-nav-step {
    width: 34px;
    text-align: center;
    font-family: ui-monospace, "SF Mono", Consolas, monospace;
    font-size: 11px;
    color: #fff;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.25);
    border-radius: 6px;
    padding: 4px 2px;
    -moz-appearance: textfield;
  }

  .dev-nav-step::-webkit-outer-spin-button,
  .dev-nav-step::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  .dev-nav-step:focus {
    outline: none;
    border-color: rgba(255, 255, 255, 0.6);
    background: rgba(255, 255, 255, 0.2);
  }
</style>
