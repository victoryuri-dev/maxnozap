---
import Layout from '../layouts/Layout.astro';
import { quizQuestions, TOTAL_STEPS } from '../data/quiz-questions';

const CAPTURE_STEP = quizQuestions.length + 1;
const LOADING_STEP = quizQuestions.length + 2;
const DIAG_STEP = quizQuestions.length + 3;
const SOLUTION_STEP = quizQuestions.length + 4;
---

<Layout title="Quiz — Max no Zap">
  <div class="phone no-footer" data-total={TOTAL_STEPS} data-diag-step={DIAG_STEP}>
    <div class="progress">
      <div class="bar" id="bar"></div>
    </div>

    <div class="screen-stack">
      <!-- TELA 0 -->
      <div class="screen active" data-step="0">
        <div class="hero-wrap">
          <img class="hero-swoosh" src="/img/m-swoosh.png" alt="" />
          <img class="hero-img" src="/img/max fala.png" alt="Max acenando" />
        </div>

        <div class="s0-sheet">
          <div class="content-col">
            <h2 class="hero-title">Fala, chefe!</h2>
            <p class="sub">Bora descobrir quanto tempo (e dinheiro) o orçamento no papel tá te custando?</p>
            <p class="sub">São só <span class="hl">7 perguntinhas rápidas</span></p>
            <p class="sub">No final eu mostro o seu diagnóstico.</p>
            <button class="btn" data-action="push-up">bora!</button>
          </div>
        </div>
      </div>

      <!-- PERGUNTAS (geradas a partir de src/data/quiz-questions.ts) -->
      {
        quizQuestions.map((q, i) => {
          const step = i + 1;
          const next = i + 2;
          return (
            <div class="screen" data-step={step}>
              <div class="content-col">
                <div class="step-tag">{q.tag}</div>
                <h2>{q.question}</h2>
                {q.options.map((opt) => (
                  <button class="opt" data-action="pick" data-next={next} data-value={opt.value ?? opt.label} data-track={q.track ?? ''}>
                    {opt.emoji && <span class="em">{opt.emoji}</span>} {opt.label}
                  </button>
                ))}
              </div>
            </div>
          );
        })
      }

      <!-- CAPTURA -->
      <div class="screen" data-step={CAPTURE_STEP}>
        <div class="content-col">
          <div class="brand"><img class="brand-logo" src="/img/assinatura digital.png" alt="" /> MAX NO ZAP</div>
          <h2>Pronto, chefe! Montei teu diagnóstico 🔧</h2>
          <p class="sub">
            Com base no que você me contou, já sei onde tá vazando dinheiro na tua oficina. Me passa teu WhatsApp que
            eu te mostro <b>e já te mando o resumo no Zap</b>:
          </p>
          <input class="field" id="nome" placeholder="Como te chamo?" autocomplete="off" />
          <input class="field" id="zap" placeholder="Teu WhatsApp com DDD" inputmode="tel" autocomplete="off" />
          <p class="err" id="err">Pô, chefe, confere esse número aí 😅</p>
          <button class="btn" data-action="capturar">VER MEU DIAGNÓSTICO</button>
          <p class="micro">Prometo: nada de spam. Só teu diagnóstico e teus 3 orçamentos grátis. 🤝</p>
        </div>
      </div>

      <!-- LOADING -->
      <div class="screen" data-step={LOADING_STEP}>
        <div class="content-col">
          <div class="loader-wrap">
            <div class="spinner"></div>
            <div class="load-txt" id="loadTxt">Analisando tuas respostas...</div>
          </div>
        </div>
      </div>

      <!-- DIAGNÓSTICO -->
      <div class="screen" data-step={DIAG_STEP}>
        <div class="content-col">
          <div class="diag-head">
            <div class="t">🔧 DIAGNÓSTICO DO <span id="diagNome">CHEFE</span></div>
            <div class="s">Feito com base nas tuas respostas</div>
          </div>
          <div class="diag-card">
            <h3>⏱️ Tempo</h3>
            <p>
              Se você gasta <strong id="diagTempo">~30 min</strong> por orçamento, isso dá fácil
              <strong>várias horas por semana</strong> só fazendo orçamento. No mês, é praticamente
              <strong>uma semana inteira de trabalho</strong> que não entra no caixa.
            </p>
          </div>
          <div class="diag-card">
            <h3>💸 Dinheiro</h3>
            <p>
              Cada pechinchada de 10% num serviço de R$ 800 = <strong>R$ 80 que ficam na mesa</strong>. Somando os
              clientes que somem sem resposta, dá pra estar deixando <strong id="diagFaixa">R$ 1.000 a R$ 3.000</strong>
              por mês sem nem perceber.
            </p>
          </div>
          <div class="diag-card">
            <h3>🎯 Resumo</h3>
            <p>
              Teu problema não é mão de obra, chefe. É <strong>velocidade e apresentação</strong>. O concorrente não é
              melhor que você — ele só responde mais rápido e parece mais profissional.
            </p>
          </div>
          <button class="btn" data-action="go" data-goto={SOLUTION_STEP}>E AGORA, CHEFE? 👇</button>
        </div>
      </div>

      <!-- SOLUÇÃO -->
      <div class="screen" data-step={SOLUTION_STEP}>
        <div class="content-col">
          <div class="ba-img">
            <img src="/img/antes-depois.png" alt="Antes: orçamento no papel · Depois: orçamento PDF profissional" />
          </div>
          <h2>Relaxa, chefe. Isso tem conserto — e eu resolvo. 🫡</h2>
          <p class="sub">Sou o <b>Max</b>, teu funcionário digital no WhatsApp.</p>
          <div class="steps-mini">
            <div><span class="em">🎙️</span> Você manda o áudio do serviço</div>
            <div><span class="em">⚡</span> Eu entendo e monto na hora</div>
            <div><span class="em">📄</span> Sai o PDF profissional com a logo da tua oficina em 30s</div>
          </div>
          <div class="offer">
            <div class="gift">🎁</div>
            <div class="big">TEUS 3 PRIMEIROS ORÇAMENTOS SÃO GRÁTIS</div>
            <div class="small">Sem cartão, sem compromisso. Testa na prática e vê com teus olhos.</div>
          </div>
          <a
            class="btn"
            href="https://wa.me/5537999274941?text=Fala,%20Max!%20Fiz%20o%20quiz%20e%20vi%20meu%20diagn%C3%B3stico.%20Quero%20meus%203%20or%C3%A7amentos%20gr%C3%A1tis!"
            target="_blank"
            rel="noopener"
          >
            👉 MANDAR MEU PRIMEIRO ÁUDIO
          </a>
          <span class="link-human">Prefiro falar com uma pessoa</span>
        </div>
      </div>
    </div>

    <div class="phone-footer">@maxnozape</div>
  </div>

  <script src="../scripts/quiz.ts"></script>
</Layout>
