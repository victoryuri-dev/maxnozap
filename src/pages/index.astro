---
import Layout from '../layouts/Layout.astro';
import { quizQuestions, type QuizQuestion } from '../data/quiz-questions';

// Telas 1..N: intercala uma tela de transição (só texto) antes de qualquer pergunta
// que tenha `transitionBefore`, e uma tela por pergunta — nessa ordem sequencial.
type ScreenEntry = { type: 'transition'; text: string } | { type: 'question'; data: QuizQuestion };

const screens: ScreenEntry[] = [];
for (const q of quizQuestions) {
  if (q.transitionBefore) screens.push({ type: 'transition', text: q.transitionBefore });
  screens.push({ type: 'question', data: q });
}

const CAPTURE_STEP = screens.length + 1;
const LOADING_STEP = screens.length + 2;
const DIAG_STEP = screens.length + 3;
const SOLUTION_STEP = screens.length + 4;
const TOTAL_STEPS = screens.length + 4;
---

<Layout title="Quiz — Max Orça">
  <div
    class="phone no-footer"
    data-total={TOTAL_STEPS}
    data-capture-step={CAPTURE_STEP}
    data-loading-step={LOADING_STEP}
    data-diag-step={DIAG_STEP}
    data-solution-step={SOLUTION_STEP}
  >
    <div class="progress">
      <div class="bar" id="bar"></div>
    </div>

    <div class="screen-stack">
      <!-- TELA 0 -->
      <div class="screen hero-screen active" data-step="0" data-track-label="hero">
        <div class="hero-wrap">
          <img class="hero-swoosh" src="/img/m-swoosh.png" alt="" />
          <img class="hero-img" src="/img/max fala.png" alt="Max acenando" />
        </div>

        <div class="s0-sheet">
          <div class="content-col">
            <h2 class="hero-title">Fala, chefe! 👋</h2>
            <p class="sub">Quanto você perdeu mês passado por demorar pra mandar orçamento?</p>
            <p class="sub">Não sabe? Então bora descobrir — leva 1 minuto.</p>
            <button class="btn" data-action="push-up">BORA!</button>
            <p class="micro">Leva menos de 1 minuto</p>
          </div>
        </div>
      </div>

      <!-- PERGUNTAS E TRANSIÇÕES (geradas a partir de src/data/quiz-questions.ts) -->
      {
        screens.map((s, i) => {
          const step = i + 1;
          const next = i + 2;

          if (s.type === 'transition') {
            return (
              <div class="screen transition-screen" data-step={step} data-track-label="transicao">
                <div class="content-col">
                  <p class="transition-text">{s.text}</p>
                  <p class="micro">toque pra continuar</p>
                </div>
                <button class="screen-tap" data-action="advance" data-next={next} aria-label="Continuar" />
              </div>
            );
          }

          const q = s.data;
          return (
            <div class="screen" data-step={step} data-question-id={q.id} data-track-label={q.id}>
              <div class="content-col">
                <div class="step-tag">{q.tag}</div>
                <h2>{q.question}</h2>
                {q.options.map((opt) => (
                  <button class="opt" data-action="pick" data-next={next} data-value={opt.value} data-label={opt.label}>
                    {opt.emoji && <span class="em">{opt.emoji}</span>} {opt.label}
                  </button>
                ))}
              </div>
            </div>
          );
        })
      }

      <!-- CAPTURA -->
      <div class="screen" data-step={CAPTURE_STEP} data-track-label="captura">
        <div class="content-col">
          <div class="brand"><img class="brand-logo" src="/img/assinatura digital.png" alt="" /> MAX ORÇA</div>
          <h2>Pronto, chefe! Montei teu diagnóstico 🔧</h2>
          <p class="sub">
            Com base no que você me contou, já sei onde tá vazando dinheiro na tua oficina. Me passa teu WhatsApp que
            eu te mostro <b>e já te mando o resumo no Zap</b>:
          </p>
          <input class="field" id="nome" placeholder="Como te chamo?" autocomplete="off" />
          <input class="field" id="zap" placeholder="Teu WhatsApp com DDD" inputmode="tel" autocomplete="off" />
          <p class="err" id="err">Pô, chefe, confere esse número aí 😅</p>
          <button class="btn" data-action="capturar">VER MEU DIAGNÓSTICO</button>
          <p class="micro">Prometo: nada de spam. Só teu diagnóstico e teus 3 orçamentos grátis. 🤝</p>
        </div>
      </div>

      <!-- LOADING -->
      <div class="screen bg-azul" data-step={LOADING_STEP} data-track-label="loading">
        <div class="content-col loading-content">
          <div class="loader-wrap">
            <div class="spinner"></div>
            <div class="load-txt" id="loadTxt">Analisando tuas respostas...</div>
          </div>
        </div>
      </div>

      <!-- DIAGNÓSTICO -->
      <div class="screen bg-azul" data-step={DIAG_STEP} data-track-label="diagnostico">
        <div class="content-col diag-content">
          <div class="diag-hero">
            <div class="diag-hero-eyebrow">🔧 Diagnóstico do <span id="diagNome">CHEFE</span></div>
            <p class="diag-hero-lead">Você está tendo um <strong>prejuízo</strong> estimado de</p>
            <div class="diag-hero-value"><span id="diagPrejuizo">R$ 1.000 a R$ 3.000</span> por mês!!</div>
          </div>

          <div class="diag-row">
            <span class="diag-row-icon">⏱️</span>
            <div class="diag-row-body">
              <div class="diag-row-title" id="diagHoras">~7 horas por semana</div>
              <div class="diag-row-sub">só fazendo orçamento na mão</div>
            </div>
          </div>

          <div class="diag-row">
            <span class="diag-row-icon">😤</span>
            <div class="diag-row-body">
              <div class="diag-row-title">Cliente foge da demora</div>
              <div class="diag-row-sub" id="diagP4">perde cliente direto por demora</div>
            </div>
          </div>

          <div class="diag-row">
            <span class="diag-row-icon">💸</span>
            <div class="diag-row-body">
              <div class="diag-row-title">O papel convida desconto</div>
              <div class="diag-row-sub" id="diagP5">pede desconto sempre</div>
            </div>
          </div>

          <p class="diag-veredito">O problema não é a mão de obra. <strong>É velocidade e apresentação!</strong> 🎯</p>

          <p class="diag-cta-lead">Bora resolver isso <span class="hl-lime">agora mesmo</span>, chefe? 👇</p>

          <button class="btn btn-lime" data-action="push" data-next={SOLUTION_STEP}>VAMOS CORRIGIR ISSO!</button>
        </div>
      </div>

      <!-- SOLUÇÃO — OFERTA E CTA -->
      <div class="screen bg-preto" data-step={SOLUTION_STEP} data-track-label="solucao_final">
        <div class="content-col">
          <div class="audio-head">
            <h2>É só entrar no link abaixo e <strong>mandar um áudio</strong>!</h2>
            <img class="whats-sticker" src="/img/sticker.png" alt="Funciona dentro do WhatsApp" />
          </div>

          <p class="audio-note">Sem <strong class="hl-muted">app</strong> pra baixar</p>
          <p class="audio-note">Nem <strong class="hl-muted">cadastro</strong> chato</p>

          <a
            class="audio-cta"
            href="https://wa.me/5537999274941?text=Fala,%20Max!%20Fiz%20o%20quiz%20e%20vi%20meu%20diagn%C3%B3stico.%20Quero%20meus%203%20or%C3%A7amentos%20gr%C3%A1tis!"
            target="_blank"
            rel="noopener"
          >
            TOQUE AQUI PARA COMEÇAR!
          </a>

          <img class="gift-img efeito-flutuante-infinito" src="/img/gift.png" alt="Presente" />
        </div>
      </div>
    </div>

    <div class="phone-footer">@maxorca</div>
  </div>

  {
    import.meta.env.DEV && (
      <div class="dev-nav">
        <button type="button" class="dev-nav-btn" data-action="dev-prev" aria-label="Etapa anterior">
          ‹
        </button>
        <input
          class="dev-nav-step"
          id="devStep"
          type="number"
          inputmode="numeric"
          min="0"
          max={TOTAL_STEPS}
          value="0"
          aria-label="Ir direto pra etapa"
        />
        <button type="button" class="dev-nav-btn" data-action="dev-next" aria-label="Próxima etapa">
          ›
        </button>
      </div>
    )
  }

  <script src="../scripts/quiz.ts"></script>
</Layout>
